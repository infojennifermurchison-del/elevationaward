# ── RISEhigHER Elevation Award — environment ─────────────────────────────────
# Copy to ".env" and fill in. Nothing here depends on any external platform.

# Session cookie signing secret. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin. On startup the app creates this account (or promotes an
# existing/imported account with this email) and sets this password. This is
# how you sign in to the admin dashboard.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Administrator

# Where the SQLite database and uploaded documents live. Defaults to ./data.
# Back up this one folder and you've backed up the whole app.
# DATA_DIR=./data

# Port to listen on (default 3000).
# PORT=3000

# Optional: POST a JSON notification to this URL when an application is
# submitted (e.g. a Slack/Zapier incoming webhook). Leave blank to just log.
# OWNER_NOTIFY_WEBHOOK=

# Optional: public base URL of the deployed site (used for building links).
# APP_URL=https://yourdomain.com
